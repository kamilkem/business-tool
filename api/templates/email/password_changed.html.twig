{# Sent after a signed-in user changed their own password with POST /api/me/password (#12). Context:
   firstName (may be empty). Rendered by the queue worker (adr/0012) in the recipient's language
   (ADR 0028 §6): texts in translations/email+intl-icu.*. #}
{% trans_default_domain 'email' %}
<p>{{ firstName ? 'common.hello_name'|trans({firstName: firstName}) : 'common.hello'|trans }}</p>
<p>{{ 'password_changed.body'|trans }}</p>
<p>{{ 'password_changed.not_you'|trans }}</p>
