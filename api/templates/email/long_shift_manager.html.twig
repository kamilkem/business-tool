{# To each active owner and manager but the person when a shift runs longer than the organization's
   maximum shift length (#33), once per shift. Context: firstName, employeeName, organizationName,
   startedAt (formatted in the organization's time zone and the recipient's language), hours (whole
   hours so far), maxShiftHours, timeZone, link (the admin's shifts). Rendered by the queue worker
   (adr/0012) in the recipient's language (ADR 0028 §6): texts in translations/email+intl-icu.*. #}
{% trans_default_domain 'email' %}
<p>{{ 'common.hello_name'|trans({firstName: firstName}) }}</p>
<p>{{ 'long_shift_manager.body'|trans({employeeName: employeeName, organizationName: organizationName, startedAt: startedAt, hours: hours, maxShiftHours: maxShiftHours}) }}</p>
<p>{{ 'long_shift_manager.check_prompt'|trans }} {{ 'long_shift_manager.times_in'|trans({timeZone: timeZone}) }}</p>
<p><a href="{{ link }}">{{ 'long_shift_manager.link'|trans }}</a></p>
