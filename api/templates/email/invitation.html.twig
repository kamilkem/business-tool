{# Invitation for a new member to set their first password (ADR 0013). Context: firstName,
   organizationName, inviterName, link, validForDays. Rendered by the queue worker (adr/0012) in the
   recipient's language (ADR 0028 §6): texts in translations/email+intl-icu.*. #}
{% trans_default_domain 'email' %}
<p>{{ 'common.hello_name'|trans({firstName: firstName}) }}</p>
<p>{{ 'invitation.intro'|trans({inviterName: inviterName, organizationName: organizationName}) }}</p>
<p>{{ 'invitation.set_password_prompt'|trans }}</p>
<p><a href="{{ link }}">{{ 'invitation.set_password_link'|trans }}</a></p>
<p>{{ 'invitation.expiry'|trans({validForDays: validForDays, inviterName: inviterName}) }}</p>
<p>{{ 'invitation.not_expected'|trans }}</p>
