{# Password reset link, requested with POST /api/auth/password-reset (ADR 0013, #13). Context:
   firstName (may be empty), link, validForMinutes. Rendered by the queue worker (adr/0012) in the
   recipient's language (ADR 0028 §6): texts in translations/email+intl-icu.*. #}
{% trans_default_domain 'email' %}
<p>{{ firstName ? 'common.hello_name'|trans({firstName: firstName}) : 'common.hello'|trans }}</p>
<p>{{ 'password_reset.intro'|trans }}</p>
<p><a href="{{ link }}">{{ 'password_reset.link'|trans }}</a></p>
<p>{{ 'password_reset.expiry'|trans({validForMinutes: validForMinutes}) }}</p>
<p>{{ 'password_reset.not_you'|trans }}</p>
