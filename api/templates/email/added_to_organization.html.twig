{# Notification for a person who already has an account and was added to another organization
   (ADR 0013). Context: firstName, organizationName, addedByName, link. Rendered by the queue
   worker (adr/0012) in the recipient's language (ADR 0028 §6): texts in translations/email+intl-icu.*. #}
{% trans_default_domain 'email' %}
<p>{{ 'common.hello_name'|trans({firstName: firstName}) }}</p>
<p>{{ 'added_to_organization.intro'|trans({addedByName: addedByName, organizationName: organizationName}) }}</p>
<p>{{ 'added_to_organization.sign_in_prompt'|trans }}</p>
<p><a href="{{ link }}">{{ 'added_to_organization.sign_in_link'|trans }}</a></p>
