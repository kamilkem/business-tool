
###> symfony/framework-bundle ###
APP_SECRET=19e81f62a1c31b85a5101a049f5a88f6
###< symfony/framework-bundle ###

# Dev/test only: encrypts the locally generated JWT keys (config/jwt, git-ignored).
JWT_PASSPHRASE=dev-only-jwt-passphrase

# Dev only: the keyring that encrypts per-organization secrets (adr/0026 §3). The key is base64 of
# the text "dev-only-key-not-for-production!". Deliberately not in .env: a deployment without its own
# keyring fails instead of using a known key. `bin/console app:secret:generate-key` prints a real one.
SECRETS_ENCRYPTION_KEYS=dev-1:ZGV2LW9ubHkta2V5LW5vdC1mb3ItcHJvZHVjdGlvbiE=

# Mailpit from compose.yaml (`make mail` opens the inbox; adr/0012). Kept out of compose.yaml so that
# PHPUnit in the same container still gets null:// from .env.test.
MAILER_DSN=smtp://mailer:1025
