# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Dev/test only: encrypts the locally generated JWT keys (config/jwt, git-ignored).
JWT_PASSPHRASE=dev-only-jwt-passphrase

# Nothing leaves the test process: e-mails are queued in memory and sent to the null transport.
MAILER_DSN=null://null
MESSENGER_TRANSPORT_DSN=in-memory://
MESSENGER_FAILED_TRANSPORT_DSN=in-memory://
