# The app's configuration for one stage (adr/0035 §9): /srv/business-tool/<stage>/app.env, readable by
# root only, written by the deploy from the stage's GitHub Environment. Real environment variables
# win over api/.env, so everything a stage needs is set here. Values below are placeholders; the
# owner's password manager holds the real secrets.

# —— Secrets ————————————————————————————————————————————————————————————————————————————————
# `openssl rand -hex 32`
APP_SECRET=change-me
# The stage's own database and role on the edge's PostgreSQL (deploy/edge/initdb).
DATABASE_URL=postgresql://business_tool_production:change-me@database:5432/business_tool_production?serverVersion=17&charset=utf8
# Passphrase of jwt/private.pem (`bin/console lexik:jwt:generate-keypair` with this passphrase set).
JWT_PASSPHRASE=change-me
# The OVHcloud mail plan's SMTP, authenticated as no-reply@tooltipp.com (adr/0036), with the mailbox
# password URL-encoded.
MAILER_DSN=smtp://no-reply%40tooltipp.com:change-me@smtp.mail.ovh.net:587
# `bin/console app:secret:generate-key`; never in a database backup (adr/0026 §3).
SECRETS_ENCRYPTION_KEYS=k1:change-me

# —— Configuration ——————————————————————————————————————————————————————————————————————————
APP_ENV=prod
# The stage's two app hosts (no scheme); the image's Caddyfile serves one site per host. Production as
# below; staging uses admin.staging.tooltipp.com and app.staging.tooltipp.com (adr/0035 §4).
ADMIN_HOST=admin.tooltipp.com
TIMECLOCK_HOST=app.tooltipp.com
# Where e-mailed links open (adr/0013) and the base for URLs built outside a request.
ADMIN_URL=https://admin.tooltipp.com
TIMECLOCK_URL=https://app.tooltipp.com
DEFAULT_URI=https://admin.tooltipp.com
# Only the stage's own origins; the apps call /api on their own origin anyway (adr/0020).
CORS_ALLOW_ORIGIN='^https://(admin|app)\.tooltipp\.com$'
# The edge Caddy proxies from the Docker network (adr/0035 §3).
TRUSTED_PROXIES=private_ranges
# The authenticated mailbox itself (adr/0036); tooltipp.com has SPF, DKIM and DMARC (#213).
MAILER_FROM="Tooltipp <no-reply@tooltipp.com>"
# PROD in production, TEST or DEMO in staging (adr/0023 §1).
KSEF_API_URL=https://api.ksef.mf.gov.pl/v2
JWT_TOKEN_TTL=900
