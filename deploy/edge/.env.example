# Variables of the edge project (/srv/business-tool/edge/.env, root-only). Placeholders; the real
# values live in the owner's password manager.

# Let's Encrypt account e-mail.
ACME_EMAIL=owner@example.com
# The app hosts of both stages (adr/0035 §4).
PRODUCTION_ADMIN_HOST=admin.example.com
PRODUCTION_TIMECLOCK_HOST=app.example.com
STAGING_ADMIN_HOST=admin.staging.example.com
STAGING_TIMECLOCK_HOST=app.staging.example.com

# PostgreSQL superuser (maintenance and backups only) and the stages' roles (deploy/edge/initdb).
POSTGRES_PASSWORD=change-me
PRODUCTION_DB_PASSWORD=change-me
STAGING_DB_PASSWORD=change-me
