{
  "name": "@business-tool/api-client",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "generate": "openapi-typescript ${API_SPEC:-${API_URL:-http://localhost:8000}/api/docs.jsonopenapi} --default-non-nullable false -o src/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.94.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8"
  }
}
