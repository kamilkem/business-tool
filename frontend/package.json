{
  "name": "business-tool-frontend",
  "private": true,
  "packageManager": "pnpm@9.13.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:admin": "pnpm --filter admin dev",
    "dev:timeclock": "pnpm --filter timeclock dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test:catalogs": "vitest run packages/ui/src/i18n/catalogs.test.ts",
    "test": "vitest run",
    "api:types": "pnpm --filter @business-tool/api-client generate"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^5.1.0"
  }
}
